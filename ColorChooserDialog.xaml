<Window x:Class="Malin_SSS_AT2.ColorChooserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:Malin_SSS_AT2"
        mc:Ignorable="d"
        Title="Change Background Colour" Height="103" Width="418">
    <StackPanel Margin="0,0,0,-6" MinWidth="300">
        <xctk:ColorPicker x:Name="Picker"
                      UsingAlphaChannel="True"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="80" Margin="0,0,8,0" IsDefault="True" Content="OK" Click="Ok_Click"/>
            <Button Width="80" IsCancel="True" Content="Cancel"/>
        </StackPanel>
    </StackPanel>
</Window>
