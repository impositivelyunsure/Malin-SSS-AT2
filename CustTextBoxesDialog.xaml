<Window x:Class="Malin_SSS_AT2.CustTextBoxesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Malin_SSS_AT2"
        mc:Ignorable="d"
        Title="CustTextBoxesDialog" Height="450" Width="800">
    <Grid>
        <Button Content="OK" HorizontalAlignment="Left" Margin="121,187,0,0" VerticalAlignment="Top" Click="Ok_Click" Width="80"/>
        <Button Content="Cancel" IsCancel="True" HorizontalAlignment="Left" Margin="224,187,0,0" VerticalAlignment="Top" Width="80"/>
        <ComboBox Name="cbFonts" ItemsSource="{x:Static Fonts.SystemFontFamilies}" HorizontalAlignment="Left" Margin="36,67,0,0" VerticalAlignment="Top" Width="120"/>
        <Label Content="Fonts" HorizontalAlignment="Left" Margin="36,36,0,0" VerticalAlignment="Top"/>
        <Label Content="Size" HorizontalAlignment="Left" Margin="37,113,0,0" VerticalAlignment="Top"/>
        <TextBox Name="txtBoxFontSize" HorizontalAlignment="Left" Margin="36,144,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
    </Grid>
</Window>
