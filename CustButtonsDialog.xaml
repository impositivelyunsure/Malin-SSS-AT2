<Window x:Class="Malin_SSS_AT2.CustButtonsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:Malin_SSS_AT2"
        mc:Ignorable="d"
        Title="Customise Buttons" Height="247" Width="431">
    <StackPanel Margin="16">
        <Label Content="Colour"/>
        <xctk:ColorPicker x:Name="Picker" UsingAlphaChannel="True" Margin="0,0,0,4"/>
        <Label Content="Font"/>
        <ComboBox x:Name="cbFonts"
              ItemsSource="{x:Static Fonts.SystemFontFamilies}"
              DisplayMemberPath="Source"
              SelectedIndex="0">
        </ComboBox>
        <Label Content="Font size"/>
        <TextBox Name="txtFontSize" TextWrapping="Wrap" Width="120"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="90" Margin="0,0,8,0" IsDefault="True" Content="OK" Click="Ok_Click"/>
            <Button Width="90" IsCancel="True" Content="Cancel"/>
        </StackPanel>
    </StackPanel>
</Window>
