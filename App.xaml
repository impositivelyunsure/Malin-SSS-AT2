<Application x:Class="Malin_SSS_AT2.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Malin_SSS_AT2"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <FontFamily x:Key="GlobalTextBoxFont">Segoe UI</FontFamily>
        <sys:Double x:Key="GlobalTextBoxFontSize"
              xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
        <SolidColorBrush x:Key="TextBoxForegroundBrush" Color="Black"/>
        <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="White"/>

        <!-- apply to all TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource GlobalTextBoxFont}"/>
            <Setter Property="FontSize"   Value="{DynamicResource GlobalTextBoxFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBoxForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
        </Style>
    </Application.Resources>
</Application>
